{
  "id": "com.perfexxxxion.worktickets",
  "name": "Work Tickets",
  "version": "0.1.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "schemaVersion": 2,
  "permissionPolicyVersion": 1,
  "permissions": [
    { "name": "display", "required": true },
    { "name": "network", "required": true, "reason": "Read your helpdesk ticket emails and send replies" },
    { "name": "device.events", "required": true, "scope": { "types": ["button", "imuGesture", "connection"] } },
    { "name": "storage", "required": true, "reason": "Remember the ticket service password" },
    { "name": "audio.capture", "required": false, "reason": "Hear your spoken replies through the glasses mic" }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.gm.example.web-bridge",
    "protocols": [
      { "id": "gm.scene", "minVersion": "1.0" },
      { "id": "gm.device-events", "minVersion": "1.0" }
    ]
  }
}
